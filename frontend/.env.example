# Optional. Leave unset in development: Vite forwards /api to the backend (see vite.config.js).
# Set it only when the API is hosted elsewhere, e.g. the deployed backend on Render/Railway.
# VITE_API_URL=https://your-backend.example.com/api

# Optional. "Continue with Google" already uses the team's OAuth client ID (src/utils/googleSignIn.js).
# Set this only to use a different one; it must match GOOGLE_CLIENT_ID in backend/.env.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
