{
  "name": "hawker-watch",
  "private": true,
  "scripts": {
    "install:all": "pnpm install && pnpm --dir frontend install && pnpm --dir backend install",
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "test": "pnpm --dir backend test",
    "test:unit": "pnpm --dir frontend test:unit --run",
    "test:e2e": "pnpm --dir frontend test:e2e",
    "build": "pnpm --dir frontend build",
    "lint": "pnpm --dir frontend lint",
    "seed": "pnpm --dir backend seed",
    "seed:demo": "pnpm --dir backend seed:demo",
    "import:centres": "pnpm --dir backend import:centres",
    "import:stalls": "pnpm --dir backend import:stalls",
    "migrate:cuisines": "pnpm --dir backend migrate:cuisines"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "packageManager": "pnpm@12.12.1"
}
