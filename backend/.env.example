PORT=3000

# development locally. Set to production on Render/Railway: it hides server error details,
# blocks pnpm seed, and makes the login cookie work across the Vercel and API domains.
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put in your own database username and password. Do not keep the < > brackets from the Atlas template.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=HawkerWatch

# Optional. Leave unset to share the team database (hawker-watch).
# Set your own name, e.g. hawker-watch-ryan, to seed and test without wiping everyone else's data.
# MONGO_DB_NAME=hawker-watch-yourname

FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-local-development-secret

# Optional. "Continue with Google" already uses the team's OAuth client ID (backend/utils/googleAuth.js).
# Set this only to use a different one; it must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional. Failed logins allowed per IP address in 15 minutes (default 10).
# LOGIN_RATE_LIMIT_MAX=10

# Optional. Comments allowed per IP address in 15 minutes (default 10).
# COMMENT_RATE_LIMIT_MAX=10

# Optional. Reviews allowed per IP address in 15 minutes (default 10).
# REVIEW_RATE_LIMIT_MAX=10

# Optional. Review photo uploads allowed per IP address in 15 minutes (default 20).
# PHOTO_RATE_LIMIT_MAX=20

# Optional. Postal code and place searches allowed per IP address in 15 minutes (default 100).
# GEOCODE_RATE_LIMIT_MAX=100

# Optional. Community reports allowed per IP address in 15 minutes (default 10).
# REPORT_RATE_LIMIT_MAX=10

# Optional. Stalls added per IP address in 15 minutes (default 10).
# STALL_RATE_LIMIT_MAX=10

# Optional. Password for the demo login (demo@example.com) that pnpm seed creates; default Hawker#Run1.
# SEED_DEMO_PASSWORD=Hawker#Run1

# Optional. On start-up the server imports NEA's hawker centres and closures from data.gov.sg when
# there are none yet or the last import is over a week old. Set to off to stop that (pnpm import:centres still works).
# HAWKER_IMPORT_ON_START=off

# Optional. Reports must be sent from within 200 m of the hawker centre. Set to off to test or demo
# away from a centre (laptop locations are often too rough). Leave it unset on the deployed site.
# REPORT_LOCATION_CHECK=off
